rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user document data for current authenticated user
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if current user has ADMIN role
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    // Helper: Check if current user has TUTOR role (or ADMIN)
    function isTutor() {
      return isAuthenticated() && (getUserData().role == 'TUTOR' || getUserData().role == 'ADMIN');
    }

    // Users Collection:
    // - Authenticated users can read user profiles.
    // - Users can create their own profile on sign up.
    // - Users can update their own profile, BUT only an ADMIN can change user roles or statuses (ACTIVE/PENDING/SUSPENDED).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Departments Collection: Public read, admin write.
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses Collection: Public read, admin write/create.
    match /courses/{courseCode} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Enrollments Collection:
    // - Authenticated users can read.
    // - Students can only create/update their own enrollments where studentId matches their auth uid.
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    // Tutors & TutorProfiles Collections:
    // - Public read for course catalog and directory browsing.
    // - Tutors can write only their own profile (tutorId / uid == request.auth.uid).
    // - Only ADMIN can verify tutors (change status to VERIFIED).
    match /tutors/{tutorId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == tutorId || isAdmin());
      allow delete: if isAdmin();
    }

    match /tutorProfiles/{tutorId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == tutorId || isAdmin());
      allow delete: if isAdmin();
    }

    // Sessions Collection:
    // - Authenticated users can read.
    // - Tutors can create and manage their own sessions (tutorId == request.auth.uid), and admins can manage all.
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isTutor() && request.resource.data.tutorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.tutorId == request.auth.uid || isAdmin());
    }

    // Materials Collection:
    // - Authenticated users can read.
    // - Tutors can upload and manage their own materials (tutorId == request.auth.uid), and admins can manage all.
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow create: if isTutor() && request.resource.data.tutorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.tutorId == request.auth.uid || isAdmin());
    }
  }
}
